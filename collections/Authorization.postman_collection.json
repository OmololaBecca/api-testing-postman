  "item": [
    {
      "name": "Admin- User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {\n    pm.response.to.have.status(201);\n});\n\npm.test(\"Access token is returned\", function () {\n    const response = pm.response.json();\n    pm.expect(response.data.token).to.exist;\n});\n\npm.test(\"success message is returned\", function () {\n    const response = pm.response.json();\n    pm.expect(response.message).to.eql(\"Login successful\");\n});\n\npm.test(\"User information is returned\", function () {\n    const response = pm.response.json();\n\n    pm.expect(response.data.id).to.exist;\n    pm.expect(response.data.name).to.exist;\n    pm.expect(response.data.verify).to.exist;\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"{{test_login}}\",\n    \"password\": \"{{test_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/v2.0/users/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v2.0",
            "users",
            "login"
          ]
        }
      },
      "response": []
    },
