      "name": "confirm swap -valid transaction",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {\n    pm.response.to.have.status(201);\n});\n\npm.test(\"Response time is less than 6000ms\", function (){\n    pm.expect(pm.response.responseTime).to.be.below(6000);\n});\n\n\npm.test(\"data.toCurrency is exactly the expected currency (btc)\", function () {\n    const jsonData = pm.response.json();\n    pm.expect(jsonData.data).to.have.property(\"toCurrency\");\n    pm.expect(jsonData.data.toCurrency).to.eql(\"btc\");\n});\n\n// Verify response toCurrency matches what was sent in the request payload\npm.test(\"Response toCurrency matches request payload toCurrency\", function () {\n    const requestBody = JSON.parse(pm.request.body.raw.replace(/\\/\\/.*$/gm, \"\").trim());\n    const jsonData = pm.response.json();\n    pm.expect(jsonData.data.toCurrency).to.eql(requestBody.toCurrency);\n});"
            ]
          }
        }
